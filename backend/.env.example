# Server
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=sqlite://data/tranche.db?mode=rwc
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_DIR=../frontend/out

# SERV Reasoning (required for live judgment)
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_MODEL=gpt-5.4-mini

# Reppo Evaluation API
# live_lite: set REPPO_CREDIT_TOKEN (x402 prepaid credits; 440 credits per eval;
#   submits to /api/v1/x402/evals and polls ~30-90s for a settled verdict)
# sandbox: no network call. The old free sandbox endpoint was retired; this mode
#   returns a labeled advisory verdict that never gates a payment.
# unconfigured: no call; assurance is reduced and shown in the UI
REPPO_MODE=auto
REPPO_API_KEY=
REPPO_CREDIT_TOKEN=
REPPO_BASE_URL=https://eval.reppo.xyz

# Payments
# ledger: internal settlement ledger, clearly labeled in UI and receipts
# passport: reserved for Kite Agent Passport payout service (see README)
KITE_MODE=ledger
KITE_PAYEE=
KITE_RECIPIENT_ADDRESS=
KITE_PAYOUT_COMMAND=
KITE_STATUS_COMMAND=

# GitHub (optional, raises rate limit and lets private-repo checks work with a token)
GITHUB_TOKEN=

# If set, POST /api/payments/:id/approve requires X-Operator-Token with this value.
# Use this whenever KITE_MODE=passport (real settlement).
OPERATOR_TOKEN=

# Assurance policy
# Allow auto-release when SERV is live but Reppo is not configured (medium assurance).
ALLOW_MEDIUM_ASSURANCE=false
# Never allow simulated engines to release funds. Keep false for honest demos.
ALLOW_FIXTURE_RELEASE=false
# Demo circuit breaker: stop calling live SERV after this much $/24h.
SERV_DAILY_BUDGET_USD=2.0
DATABASE_MAX_CONNECTIONS=5
